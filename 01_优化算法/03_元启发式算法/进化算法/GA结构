│       └── 输出：父代组合列表
│
├── 06_Crossover
│   │
│   ├── crossover(parent_a, parent_b, config, rng) -> tuple[Chromosome, Chromosome]
│   │   ├── 输入：两个父代、GAConfig、随机数生成器
│   │   └── 输出：两个子代染色体
│   │
│   └── create_offspring(parent_pairs, config, rng) -> list[Individual]
│       ├── 输入：父代组合列表、GAConfig、随机数生成器
│       └── 输出：交叉产生的子代列表
│
├── 07_Mutation
│   │
│   ├── mutate(chromosome, mutation_rate, rng) -> Chromosome
│   │   ├── 输入：染色体、变异概率、随机数生成器
│   │   └── 输出：变异后的染色体
│   │
│   └── mutate_offspring(offspring, config, rng) -> list[Individual]
│       ├── 输入：子代列表、GAConfig、随机数生成器
│       └── 输出：完成变异的子代列表
│
├── 08_Constraint_Handling
│   │
│   ├── validate_offspring(offspring, problem) -> list[bool]
│   │   ├── 输入：子代列表、Problem
│   │   └── 输出：每个子代的合法性结果
│   │
│   └── repair_offspring(offspring, problem) -> list[Individual]
│       ├── 输入：包含非法染色体的子代列表、Problem
│       └── 输出：完成修复的子代列表
│
├── 09_Survivor_Selection
│   │
│   ├── select_elites(population, elitism_count) -> list[Individual]
│   │   ├── 输入：当前Population、精英数量
│   │   └── 输出：直接保留的优秀个体
│   │
│   └── build_next_population(elites, offspring, population_size) -> Population
│       ├── 输入：精英个体、已评价子代、种群大小
│       └── 输出：下一代Population
│
├── 10_Termination_And_Result
│   │
│   ├── update_best(best, population) -> Individual
│   │   ├── 输入：历史最好个体、当前Population
│   │   └── 输出：更新后的最好个体
│   │
│   ├── check_termination(population, best, config) -> StopStatus
│   │   ├── 输入：Population、最好个体、GAConfig
│   │   └── 输出：是否停止及停止原因
│   │
│   └── build_result(best, population, stop_status) -> GAResult
│       ├── 输入：最好个体、最终Population、停止状态
│       └── 输出：GAResult
│
├── 11_Main_Solver
│   │
│   └── run(problem, config) -> GAResult
│       ├── 输入
│       │   ├── problem：Problem问题对象
│       │   └── config：GAConfig配置对象
│       ├── 调用流程
│       │   ├── initialize_population(problem, config)
